  "headers": {
    "investments_required": ["Shares", "Cost", "Fair Value"],
    "realized_required": [],
    "header_token_patterns": ["shares", "cost", "fair value", "fv/share", "cost/share"],
    "ignore_row_patterns": [
      "^private investments:?$",
      "^crypto assets.*$",
      "^shares$",
      "^total$"
    ]
  },
  "row_classification": {
    "date_pattern": "^\\d{1,2}/\\d{1,2}/\\d{4}$",
    "grand_total_company_tokens": ["", "total", "total portfolio investments"],
    "currency_tokens": ["$"],
    "dash_tokens": ["-", "—", "–", "$-", "$ -"],
    "blank_tokens": ["", "nan", "none"],
    "mode": "dynamic_column_map"
  },
  "field_semantics": {
    "cost": {"dash_means": "zero"},
    "fair_value": {"dash_means": "zero"},
    "unrealized_gain_loss": {"dash_means": "zero"},
    "shares": {"dash_means": "not_disclosed"},
    "cost_per_share": {"dash_means": "not_disclosed"},
    "fmv_per_share": {"dash_means": "not_disclosed"}
  },
  "reconciliation": {
    "tolerance_absolute": "1",
    "tolerance_reason": "Allow $1 rounding",
    "golden_required": false,
    "statement_of_assets": {
      "investments_fair_value": null,
      "investments_cost": null,
      "net_realized_gain_loss": null,
