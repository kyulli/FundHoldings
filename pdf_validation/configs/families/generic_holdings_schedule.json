    "statement_of_assets": {
      "pages": "2",
      "table_areas": null,
      "columns": null
    }
  },
  "pdfplumber": {
    "investments": {
      "pages": [],
      "crop_bbox": [20, 80, 780, 560],
      "table_settings": {
        "vertical_strategy": "explicit",
        "horizontal_strategy": "text",
        "explicit_vertical_lines": [20, 220, 310, 400, 520, 640, 760, 780],
        "text_x_tolerance": 3,
        "text_y_tolerance": 3,
        "intersection_tolerance": 5
      }
    },
    "realized": {
      "pages": [],
      "crop_bbox": [20, 80, 780, 560],
      "table_settings": {
        "vertical_strategy": "explicit",
