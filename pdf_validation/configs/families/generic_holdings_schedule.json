  "cross_page": {"continuation_companies": []},
  "metadata_patterns": {
    "fund_name": ".+",
    "report_type": "Financial Statements|Quarterly Report",
    "as_of_date": "(January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},\\s*\\d{4}",
    "audit_status": "Unaudited|Audited",
    "currency_hint_tokens": ["$"],
    "unit_hint": "ones"
  },
  "prefer_text_fallback": true
